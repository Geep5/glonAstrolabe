	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.0.0",
		"@webgpu/types": "^0.1.71",
		"esbuild": "^0.28.1",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"unplugin-typegpu": "^0.11.6"
	}
